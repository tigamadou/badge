badge.local {
	tls internal
	reverse_proxy app:3000
}

pma.badge.local {
	tls internal
	reverse_proxy phpmyadmin:80
}

mail.badge.local {
	tls internal
	reverse_proxy mailpit:8025
}

s3.badge.local {
	tls internal
	# La console RustFS vit sous /rustfs/console/ ; la racine repond 403.
	# GET uniquement : la console poste son login (STS AssumeRole) sur `POST /`.
	@consoleRoot {
		method GET
		path /
	}
	redir @consoleRoot /rustfs/console/
	reverse_proxy rustfs:9001
}
