badge.local {
	tls internal
	reverse_proxy app:3000
}

pma.badge.local {
	tls internal
	reverse_proxy phpmyadmin:80
}

mail.badge.local {
	tls internal
	reverse_proxy mailpit:8025
}

s3.badge.local {
	tls internal
	# La console RustFS vit sous /rustfs/console/ ; la racine repond 403.
	# GET non signe uniquement : la console poste son login (STS AssumeRole) sur
	# `POST /` et liste les buckets par un `GET /` signe (ListBuckets).
	@consoleRoot {
		method GET
		path /
		not header Authorization *
	}
	redir @consoleRoot /rustfs/console/
	reverse_proxy rustfs:9001
}
