# syntax=docker/dockerfile:1
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache bash git \
    chromium nss freetype ttf-freefont harfbuzz ca-certificates
RUN corepack enable

# Playwright utilise le chromium systeme d'Alpine (voir playwright.config.ts).
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium-browser

# Install deps first (layer cache), then copy sources so prisma/schema.prisma exists for generate.
COPY package.json yarn.lock .yarnrc.yml .npmrc ./
RUN --mount=type=secret,id=npm_token \
    export NPM_TOKEN="$(cat /run/secrets/npm_token)" && (yarn install --frozen-lockfile || yarn install)

COPY . .

EXPOSE 3000

CMD ["sh", "-c", "yarn install && yarn prisma generate && yarn dev"]
