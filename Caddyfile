# Unique reverse proxy de l'hote (stack de production, ports 80/443).
# Sert la production ET la preproduction, cette derniere etant jointe via le
# reseau partage `badge_web` (cf. docker-compose.preprod.yml).
#
# Les upstreams utilisent les `container_name`, pas les noms de service : sur le
# reseau partage, les deux stacks exposent toutes deux les alias `app`,
# `phpmyadmin` et `rustfs`, ce qui rendrait la resolution DNS ambigue.

# ============================================================
#  Production
# ============================================================
badge.bj {
	reverse_proxy badge-app:3000
}

pma.badge.bj {
	reverse_proxy badge-pma:80
}

# Console d'administration RustFS. Seule la console (9001) est exposee ;
# l'API S3 (9000) reste interne au reseau Docker (accedee par `app`).
# La console vit sous /rustfs/console/ ; la racine repond 403.
s3.badge.bj {
	# GET uniquement : la console poste son login (STS AssumeRole) sur `POST /`.
	@consoleRoot {
		method GET
		path /
	}
	redir @consoleRoot /rustfs/console/
	reverse_proxy badge-rustfs:9001
}

# ============================================================
#  Preproduction
# ============================================================
preprod.badge.bj {
	reverse_proxy badge-app-preprod:3000
}

preprod.pma.badge.bj {
	reverse_proxy badge-pma-preprod:80
}

preprod.s3.badge.bj {
	# GET uniquement : la console poste son login (STS AssumeRole) sur `POST /`.
	@consoleRoot {
		method GET
		path /
	}
	redir @consoleRoot /rustfs/console/
	reverse_proxy badge-rustfs-preprod:9001
}
