# Defaults for `docker compose -f docker-compose.dev.yml`.
# Override by creating a `.env` in the project root (merged by Compose; `.env` wins on conflicts).

DATABASE_URL=mysql://root:password@mysql:3306/badge


# ADR 2026-06-01 (v2-14 Task 16) : noms PLATFORM_SMTP_* alignes sur v2.
# Le seed lit ces variables (PLATFORM_SMTP_*) pour initialiser PlatformSettings ;
# l'app fonctionnelle lit ensuite directement PlatformSettings via getPlatformSmtp().
PLATFORM_SMTP_HOST=mailpit
PLATFORM_SMTP_PORT=1025
PLATFORM_SMTP_FROM=noreply@badge.local
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_SECURE=false

NEXTAUTH_URL=https://badge.local
NEXTAUTH_SECRET=development-only-change-me

# Google reCAPTCHA test keys (always pass; replace for real verification)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# v4 : stockage objet S3-compatible (MinIO en dev). storage.ts lit ces variables.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=badge-dev
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
