{
  "formatVersion": 1,
  "family": "default",
  "label": "Badge standard",
  "description": "Badge mono-face au format carte bancaire (CR80 paysage). Photo a gauche, identite et QR code a droite, bande categorie pleine couleur en bas.",
  "page": { "widthMm": 85.6, "heightMm": 54, "count": 1 },
  "blocks": [
    {
      "type": "image",
      "page": 1,
      "x": 2,
      "y": 10,
      "w": 28,
      "h": 34,
      "source": "participant.photoDataUrl",
      "radiusMm": 1,
      "visibleIf": [
        { "path": "category.anonymous", "equals": false },
        { "path": "participant.photoDataUrl", "isEmpty": false }
      ]
    },
    {
      "type": "rect",
      "page": 1,
      "x": 2,
      "y": 10,
      "w": 28,
      "h": 34,
      "fill": "#e2e8f0",
      "radiusMm": 1,
      "visibleIf": [{ "path": "category.anonymous", "equals": true }]
    },
    {
      "type": "rect",
      "page": 1,
      "x": 2,
      "y": 10,
      "w": 28,
      "h": 34,
      "fill": "#e2e8f0",
      "radiusMm": 1,
      "visibleIf": [
        { "path": "category.anonymous", "equals": false },
        { "path": "participant.photoDataUrl", "isEmpty": true }
      ]
    },
    {
      "type": "text",
      "page": 1,
      "x": 32,
      "y": 3,
      "w": 50.6,
      "h": 4,
      "text": "{event.title}",
      "style": { "sizePt": 9, "weight": 600, "color": "#0f172a", "overflow": "clip" }
    },
    {
      "type": "text",
      "page": 1,
      "x": 32,
      "y": 8,
      "w": 50.6,
      "h": 6,
      "text": "{participant.firstName} {participant.lastName}",
      "style": {
        "sizePt": 12,
        "weight": 700,
        "color": "#0f172a",
        "overflow": "clip",
        "lineHeight": 1.2
      },
      "visibleIf": [{ "path": "category.anonymous", "equals": false }]
    },
    {
      "type": "text",
      "page": 1,
      "x": 32,
      "y": 8,
      "w": 50.6,
      "h": 6,
      "text": "Participant anonyme",
      "style": {
        "sizePt": 12,
        "weight": 700,
        "color": "#0f172a",
        "overflow": "clip",
        "lineHeight": 1.2
      },
      "visibleIf": [{ "path": "category.anonymous", "equals": true }]
    },
    {
      "type": "text",
      "page": 1,
      "x": 32,
      "y": 14.5,
      "w": 50.6,
      "h": 4,
      "text": "{participant.structure}",
      "style": { "sizePt": 8, "color": "#475569", "overflow": "clip" },
      "visibleIf": [{ "path": "category.anonymous", "equals": false }]
    },
    {
      "type": "text",
      "page": 1,
      "x": 32,
      "y": 40,
      "w": 30,
      "h": 4,
      "text": "#{badge.id}",
      "style": { "sizePt": 7, "color": "#64748b", "overflow": "clip" }
    },
    {
      "type": "qr",
      "page": 1,
      "x": 66.6,
      "y": 28,
      "w": 16,
      "h": 16
    },
    {
      "type": "rect",
      "page": 1,
      "x": 0,
      "y": 46,
      "w": 85.6,
      "h": 8,
      "fill": "category.color",
      "visibleIf": [{ "path": "category.neutralBadge", "equals": false }]
    },
    {
      "type": "rect",
      "page": 1,
      "x": 0,
      "y": 46,
      "w": 85.6,
      "h": 8,
      "fill": "#ffffff",
      "borderTopPt": 1,
      "borderColor": "category.color",
      "visibleIf": [{ "path": "category.neutralBadge", "equals": true }]
    },
    {
      "type": "text",
      "page": 1,
      "x": 0,
      "y": 48.5,
      "w": 85.6,
      "h": 4,
      "text": "{category.name}",
      "style": {
        "sizePt": 9,
        "weight": 700,
        "align": "center",
        "color": "#ffffff",
        "overflow": "clip",
        "transform": "uppercase",
        "letterSpacing": 0.5
      },
      "visibleIf": [{ "path": "category.neutralBadge", "equals": false }]
    },
    {
      "type": "text",
      "page": 1,
      "x": 0,
      "y": 48.5,
      "w": 85.6,
      "h": 4,
      "text": "{category.name}",
      "style": {
        "sizePt": 9,
        "weight": 700,
        "align": "center",
        "color": "category.color",
        "overflow": "clip",
        "transform": "uppercase",
        "letterSpacing": 0.5
      },
      "visibleIf": [{ "path": "category.neutralBadge", "equals": true }]
    }
  ]
}
