{
  "formatVersion": 1,
  "family": "recto-verso",
  "label": "Badge recto-verso",
  "description": "Badge portrait deux faces. Recto : titre, photo, identite et QR code. Verso : logo, evenement, periode et bande categorie.",
  "page": { "widthMm": 74, "heightMm": 105, "count": 2 },
  "blocks": [
    {
      "type": "text",
      "page": 1,
      "x": 6,
      "y": 10,
      "w": 62,
      "h": 5,
      "text": "{event.title}",
      "style": { "sizePt": 11, "weight": 600, "align": "center", "color": "#0f172a", "overflow": "clip" }
    },
    {
      "type": "image",
      "page": 1,
      "x": 12,
      "y": 20,
      "w": 50,
      "h": 60,
      "source": "participant.photoDataUrl",
      "radiusMm": 2,
      "visibleIf": [
        { "path": "category.anonymous", "equals": false },
        { "path": "participant.photoDataUrl", "isEmpty": false }
      ]
    },
    {
      "type": "rect",
      "page": 1,
      "x": 12,
      "y": 20,
      "w": 50,
      "h": 60,
      "fill": "#e2e8f0",
      "radiusMm": 2,
      "visibleIf": [{ "path": "category.anonymous", "equals": true }]
    },
    {
      "type": "rect",
      "page": 1,
      "x": 12,
      "y": 20,
      "w": 50,
      "h": 60,
      "fill": "#e2e8f0",
      "radiusMm": 2,
      "visibleIf": [
        { "path": "category.anonymous", "equals": false },
        { "path": "participant.photoDataUrl", "isEmpty": true }
      ]
    },
    {
      "type": "text",
      "page": 1,
      "x": 6,
      "y": 85,
      "w": 62,
      "h": 6,
      "text": "{participant.firstName} {participant.lastName}",
      "style": { "sizePt": 14, "weight": 700, "align": "center", "color": "#0f172a", "overflow": "clip" },
      "visibleIf": [{ "path": "category.anonymous", "equals": false }]
    },
    {
      "type": "text",
      "page": 1,
      "x": 6,
      "y": 85,
      "w": 62,
      "h": 6,
      "text": "Participant anonyme",
      "style": { "sizePt": 14, "weight": 700, "align": "center", "color": "#0f172a", "overflow": "clip" },
      "visibleIf": [{ "path": "category.anonymous", "equals": true }]
    },
    {
      "type": "text",
      "page": 1,
      "x": 6,
      "y": 92,
      "w": 62,
      "h": 4,
      "text": "{participant.structure}",
      "style": { "sizePt": 9, "align": "center", "color": "#475569", "overflow": "clip" },
      "visibleIf": [{ "path": "category.anonymous", "equals": false }]
    },
    {
      "type": "qr",
      "page": 1,
      "x": 23,
      "y": 68,
      "w": 28,
      "h": 28
    },
    {
      "type": "text",
      "page": 1,
      "x": 6,
      "y": 98,
      "w": 62,
      "h": 4,
      "text": "#{badge.id}",
      "style": { "sizePt": 7, "align": "center", "color": "#64748b", "overflow": "clip" }
    },
    {
      "type": "image",
      "page": 2,
      "x": 28,
      "y": 10,
      "w": 18,
      "h": 18,
      "source": "event.logoDataUrl",
      "visibleIf": [{ "path": "event.logoDataUrl", "isEmpty": false }]
    },
    {
      "type": "text",
      "page": 2,
      "x": 6,
      "y": 32,
      "w": 62,
      "h": 8,
      "text": "{event.title}",
      "style": { "sizePt": 16, "weight": 700, "align": "center", "color": "#0f172a", "overflow": "clip" }
    },
    {
      "type": "text",
      "page": 2,
      "x": 6,
      "y": 42,
      "w": 62,
      "h": 10,
      "text": "{event.date} \n {event.location}",
      "style": { "sizePt": 9, "align": "center", "color": "#475569", "overflow": "clip" }
    },
    {
      "type": "rect",
      "page": 2,
      "x": 0,
      "y": 80,
      "w": 74,
      "h": 25,
      "fill": "category.color",
      "visibleIf": [{ "path": "category.neutralBadge", "equals": false }]
    },
    {
      "type": "rect",
      "page": 2,
      "x": 0,
      "y": 80,
      "w": 74,
      "h": 25,
      "fill": "#ffffff",
      "borderTopPt": 1,
      "borderColor": "category.color",
      "visibleIf": [{ "path": "category.neutralBadge", "equals": true }]
    },
    {
      "type": "text",
      "page": 2,
      "x": 0,
      "y": 89,
      "w": 74,
      "h": 7,
      "text": "{category.name}",
      "style": {
        "sizePt": 14,
        "weight": 700,
        "align": "center",
        "color": "#ffffff",
        "overflow": "clip",
        "transform": "uppercase",
        "letterSpacing": 1
      },
      "visibleIf": [{ "path": "category.neutralBadge", "equals": false }]
    },
    {
      "type": "text",
      "page": 2,
      "x": 0,
      "y": 89,
      "w": 74,
      "h": 7,
      "text": "{category.name}",
      "style": {
        "sizePt": 14,
        "weight": 700,
        "align": "center",
        "color": "category.color",
        "overflow": "clip",
        "transform": "uppercase",
        "letterSpacing": 1
      },
      "visibleIf": [{ "path": "category.neutralBadge", "equals": true }]
    }
  ]
}
