generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================================================
//  Identity & RBAC
// =====================================================

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  password          String
  name              String
  isStaff           Boolean    @default(false)
  staffRole         StaffRole?
  inviteToken       String?    @unique
  inviteTokenExpiry DateTime?
  archived          Boolean    @default(false)
  archivedAt        DateTime?
  createdAt         DateTime   @default(now())

  // v2-11 : verification email pour comptes participants
  emailVerifiedAt        DateTime?
  emailVerifyToken       String?   @unique
  emailVerifyTokenExpiry DateTime?

  // v2-11 : reset password (compte participant et staff)
  passwordResetToken  String?   @unique
  passwordResetExpiry DateTime?

  // v2-11 : profil participant (nullable, complete progressivement). Persiste
  // entre les inscriptions ; chaque Registration en snapshote la valeur courante.
  firstName                     String?
  lastName                      String?
  structure                     String?
  photo                         String?
  idDocumentType                String?
  idDocumentNumber              String?
  idDocument                    String?
  participantProfileCompletedAt DateTime?

  // v2-11 : moderation participant. Refuse login si blocked = true.
  blocked       Boolean @default(false)
  blockedReason String?

  // v4 (plan 08) : miroir de la derniere ProfileSubmission. Ecrit UNIQUEMENT par
  // src/lib/profile-review.ts.
  profileStatus ProfileStatus @default(INCOMPLETE)

  // v2-14 Task 14 : derniere connexion reussie (mise a jour par NextAuth signIn callback).
  lastLoginAt DateTime?

  orgMemberships        OrgMembership[]
  eventMemberships      EventMembership[]
  payments              Payment[]
  activityLogs          ActivityLog[]
  registrations         Registration[]
  profileSubmissions    ProfileSubmission[]
  notifications         Notification[]
  printSheetLayouts     PrintSheetLayout[]
  printProducts         PrintProduct[]
  printSheetGenerations PrintSheetGeneration[]
}

enum StaffRole {
  // Hierarchie lineaire : SUPER_ADMIN > STAFF_ADMIN > STAFF_SUPPORT > STAFF_OBSERVER.
  // SUPER_ADMIN au sommet (decision 2026-05-31) : tous les droits, y compris hard delete
  // org et promotion STAFF_ADMIN / SUPER_ADMIN, et actions metier sur donnees client
  // (avec audit staffActor=true). En v1, SUPER_ADMIN avait des restrictions metier ;
  // cette restriction disparait en v2.
  SUPER_ADMIN
  STAFF_ADMIN
  STAFF_SUPPORT
  STAFF_OBSERVER
}

// =====================================================
//  Organization
// =====================================================

model Organization {
  id        String  @id @default(cuid())
  name      String
  legalName String?
  slug      String  @unique

  // Adresse postale structuree
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String?

  // Administratif
  taxId   String?
  website String?
  logo    String?

  // Contact public (anciennement OrgSettings - fusionne 2026-05-31)
  contactEmail String?
  contactPhone String?

  archived   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  // v2-12 : id de template de badge override pour cette org (null = heritage platform).
  // Note (2026-05-31) : OrgSettings supprime, ce champ vit directement sur Organization.
  badgeTemplateId String?

  memberships       OrgMembership[]
  events            Event[]
  categoryTemplates CategoryTemplate[]
  subscription      Subscription?
  payments          Payment[]
}

model OrgMembership {
  id           String       @id @default(cuid())
  userId       String
  orgId        String
  role         OrgRole
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

enum OrgRole {
  // Hierarchie lineaire : OWNER > MANAGER > AUDITOR (decision 2026-05-31).
  // OWNER : pleins pouvoirs sur l'org (infos administratives, archivage, membres org).
  // MANAGER : gere les events de l'org (create/archive event, membres event,
  //           CategoryTemplate), mais ne touche pas aux infos org ni a la facturation.
  // AUDITOR : lecture seule sur tout, y compris activity log (DPO, commanditaire).
  // Heritages event : OWNER et MANAGER agissent comme ADMIN event sur les events de
  // l'org parent ; AUDITOR agit comme VIEWER event.
  OWNER
  MANAGER
  AUDITOR
}

// =====================================================
//  Event
// =====================================================

model Event {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title                String
  slug                 String    @unique
  location             String
  date                 DateTime
  // v4 (plan 07) : informatif uniquement. `date` reste la date de reference pour
  // l'ID metier, les badges et l'ouverture des inscriptions.
  endDate              DateTime?
  description          String?   @db.Text
  logo                 String?
  // Consignes de securite imprimees sur les badges (liste de textes, variable
  // `list` des templates). Nullable : null vaut « aucune consigne ».
  securityInstructions Json?
  // Banniere de l'evenement (chemin de fichier, comme `logo`), source
  // event.bannerDataUrl des templates.
  banner               String?
  // Options des templates de badge : { nomDeVariable: valeur }, reglees par
  // evenement. Nullable (pas de defaut JSON sous MySQL) : null vaut « aucune ».
  templateOptions      Json?
  registrationOpen     Boolean   @default(false)
  // v2-12 : id de template de badge override pour cet event (null = heritage org/platform).
  badgeTemplateId      String?
  archived             Boolean   @default(false)
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())

  memberships           EventMembership[]
  categories            Category[]
  registrations         Registration[]
  blockedEmails         BlockedEmail[]
  blockedDocuments      BlockedDocument[]
  printSheetGenerations PrintSheetGeneration[]
  settings              EventSettings?

  @@index([orgId])
}

model EventMembership {
  id        String    @id @default(cuid())
  userId    String
  eventId   String
  role      EventRole
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

enum EventRole {
  // Hierarchie PARTIELLE (decision 2026-05-31) : ADMIN > OPERATOR > { PRINTER, VIEWER }.
  // PRINTER et VIEWER sont DISJOINTS : ni l'un n'inclut l'autre. Consequence :
  // un simple "role minimum" lineaire ne suffit plus ; les checks metier s'expriment
  // par permissions atomiques (cf. requireEventPermission dans la spec).
  // - ADMIN     : tous les droits event.
  // - OPERATOR  : lecture detaillee + approbations + scan + impression badge ;
  //               ne supprime pas, ne cree pas manuellement, ne configure pas l'event.
  // - PRINTER   : ecran d'impression badge uniquement (recherche par nom/badgeId,
  //               impression). Pas d'acces a la liste detaillee, pas de scan.
  // - VIEWER    : liste agregee uniquement (compteurs, noms, categorie, statut).
  //               Pas de details personnels (email, doc, photo), pas d'impression.
  ADMIN
  OPERATOR
  PRINTER
  VIEWER
}

// =====================================================
//  Categories (replaces v1 Team)
// =====================================================

model Category {
  id            String         @id @default(cuid())
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  color         String
  number        Int
  neutralBadge  Boolean        @default(false)
  anonymous     Boolean        @default(false)
  registrations Registration[]

  @@unique([eventId, number])
  @@unique([eventId, name])
}

model CategoryTemplate {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  color        String
  number       Int
  neutralBadge Boolean      @default(false)
  anonymous    Boolean      @default(false)
  createdAt    DateTime     @default(now())

  @@index([orgId])
}

// =====================================================
//  Registration (scoped to event)
// =====================================================

model Registration {
  // ID metier (genere par src/lib/generate-id.ts) -- format imprime sur le badge.
  id         String   @id
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // v2-11 : la registration appartient au compte participant. Le `User` porte
  // le profil persistant ; chaque registration snapshote ce profil au moment de
  // la soumission ou d'une resoumission.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status             RegistrationStatus @default(PENDING)
  badgePrinted       Boolean            @default(false)
  badgePrintedAt     DateTime?
  allAccessGranted   Boolean            @default(false)
  rejectionReason    String?
  // v4 (plan 08) : reference au catalogue ; `rejectionReason` conserve le libelle
  // fige au moment de la decision.
  rejectionReasonId  String?
  rejectionReasonRef RejectionReason?   @relation(fields: [rejectionReasonId], references: [id], onDelete: SetNull)
  rejectionDetails   String?            @db.Text

  // v2-11 : snapshot inline du profil au moment de la soumission. Reecrit a
  // chaque resoumission (pas de versionning historique). Les valeurs ici font
  // foi pour le badge imprime et l'historique.
  snapshotFirstName        String
  snapshotLastName         String
  snapshotEmail            String
  snapshotStructure        String
  snapshotPhoto            String
  snapshotIdDocumentType   String
  snapshotIdDocumentNumber String
  snapshotIdDocument       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([categoryId])
  @@index([status])
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// v4 (plan 08) : chaque envoi de pieces cree une ligne IMMUABLE. La derniere ligne
// fait foi ; `User.profileStatus` en est le miroir denormalise (cf. src/lib/profile-review.ts).
model ProfileSubmission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  photo            String
  idDocumentType   String
  idDocumentNumber String
  idDocument       String

  status               ProfileSubmissionStatus @default(PENDING)
  rejectionReasonId    String?
  rejectionReason      RejectionReason?        @relation(fields: [rejectionReasonId], references: [id], onDelete: SetNull)
  // Libelle fige a la decision : renommer ou archiver un motif ne doit pas
  // reecrire l'historique.
  rejectionReasonLabel String?
  rejectionDetails     String?                 @db.Text

  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

enum ProfileSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// v4 (plan 08) : catalogue administre dans les parametres plateforme. La portee
// filtre les motifs proposes selon le contexte de rejet.
model RejectionReason {
  id         String         @id @default(cuid())
  label      String
  scope      RejectionScope
  sortOrder  Int            @default(0)
  archived   Boolean        @default(false)
  archivedAt DateTime?
  createdAt  DateTime       @default(now())

  profileSubmissions ProfileSubmission[]
  registrations      Registration[]

  @@index([archived, scope])
}

// v4 (plan 11) : une ligne = une VERSION FIGEE d'un template installe.
// Reinstaller cree une nouvelle ligne : `layout` et `assetPrefix` ne sont JAMAIS
// mis a jour. C'est ce qui garantit qu'un evenement ne voit pas son badge changer.
// `installedById` est un identifiant nu, sans relation, comme
// ProfileSubmission.reviewedById : c'est une donnee d'audit.
model InstalledBadgeTemplate {
  id            String    @id @default(cuid())
  family        String
  version       Int
  label         String
  description   String    @db.Text
  pages         Int
  pageWidthPx   Float
  pageHeightPx  Float
  layout        Json
  // Table de liaison choisie a l'installation : nom de variable du manifeste ->
  // chemin de source du domaine badge, ou null pour « laisser vide ». Le manifeste
  // v2 declare des variables aux noms libres et ne dit pas d'ou vient une valeur :
  // c'est ici que l'application le dit. Defaut {} : une ligne migree depuis la v1
  // la recoit par script (scripts/migrate-installed-templates-v3.ts).
  bindings      Json      @default("{}")
  assetPrefix   String
  // v4 (spec 14) : previewPath designe l'IMAGE d'apercu declaree par le manifeste
  // (null si le paquet n'en fournit pas) ; proofPath l'epreuve PNG (page 1) rendue par le
  // service de rendu a l'installation ; les anciennes lignes portent un proof.pdf
  // jusqu'a la migration vers le format 3.
  previewPath   String?
  proofPath     String?
  formatVersion Int
  installedById String
  archived      Boolean   @default(false)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@unique([family, version])
  @@index([archived])
}

enum RejectionScope {
  PROFILE
  REGISTRATION
  BOTH
}

enum ProfileStatus {
  INCOMPLETE
  PENDING
  APPROVED
  REJECTED
}

// ADR 2026-06-01 (v2-14 Task 7) : eventId nullable. NULL = blocage plateforme
// (par staff), valeur = blocage event-scoped (comportement existant preserve).
// Vu la semantique "multi-NULL toleres" de MySQL InnoDB sur UNIQUE, le check
// d'unicite pour les blocages plateforme est applicatif (findFirst avant insert).
model BlockedEmail {
  id        String   @id @default(cuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([eventId, email])
  @@index([email])
}

model BlockedDocument {
  id             String   @id @default(cuid())
  eventId        String?
  event          Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  documentNumber String
  reason         String?
  createdAt      DateTime @default(now())

  @@unique([eventId, documentNumber])
  @@index([documentNumber])
}

// =====================================================
//  Settings cascade
// =====================================================

model PlatformSettings {
  id                 String  @id @default("singleton")
  smtpHost           String  @default("")
  smtpPort           Int     @default(587)
  smtpFrom           String  @default("noreply@badge.local")
  smtpUser           String  @default("")
  smtpPassword       String  @default("")
  smtpSecure         Boolean @default(false)
  // Note (2026-05-31) : reCAPTCHA est exclusivement configure ici (PlatformSettings),
  // meme logique que le SMTP. Aucun override Org/Event possible. Lecture via
  // getPlatformRecaptcha() / getPlatformPublicRecaptcha().
  recaptchaEnabled   Boolean @default(false)
  recaptchaSiteKey   String  @default("")
  recaptchaSecretKey String  @default("")
  // v2-12 : template de badge par defaut de la plateforme (racine de la cascade).
  // v4 (plan 12) : le defaut n'est plus un identifiant litteral -- il designe desormais
  // une ligne InstalledBadgeTemplate, dont le cuid n'est pas connu a l'avance. La chaine
  // vide signifie « aucune racine definie » : resolveTemplate retombe alors sur la
  // famille `default`, dont le seed garantit l'existence.
  badgeTemplateId    String  @default("")
  // v4 : droits selon l'etat de l'abonnement (actif / inactif), `{ [droit]: { active, inactive } }`.
  // Null = valeurs par defaut ; lecture tolerante via parseRights (src/lib/subscription-rights.ts).
  subscriptionRights Json?
}

// Note (2026-05-31) : le modele OrgSettings a ete supprime. Ses champs
// (contactEmail, contactPhone) ont ete fusionnes dans Organization. La cascade
// contact lit desormais directement event.organization.contactEmail.

model EventSettings {
  id      String @id @default(cuid())
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Note (2026-05-31) : pas de champs SMTP ici. Le SMTP est exclusivement
  // configure au niveau PlatformSettings (decision de design SMTP plateforme uniquement).
  contactEmail String?
  contactPhone String?
}

// =====================================================
//  Activity log
// =====================================================

model ActivityLog {
  id         String       @id @default(cuid())
  type       ActivityType
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  orgId      String?
  eventId    String?
  targetId   String?
  details    Json?
  staffActor Boolean      @default(false)
  ipAddress  String?
  userAgent  String?      @db.Text
  createdAt  DateTime     @default(now())

  @@index([type])
  @@index([orgId])
  @@index([eventId])
  @@index([userId])
  @@index([createdAt])
}

enum ActivityType {
  // Gabarits d'impression et planches de badges
  PRINT_LAYOUT_CREATED
  PRINT_LAYOUT_UPDATED
  PRINT_LAYOUT_ARCHIVED
  PRINT_SHEETS_GENERATED
  PRINT_PRODUCT_CREATED
  PRINT_PRODUCT_UPDATED
  PRINT_PRODUCT_ARCHIVED
  REGISTRATION_CREATED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  REGISTRATION_UPDATED
  REGISTRATION_DELETED
  REGISTRATION_RESUBMITTED
  // v4 (plan 15) : snapshot d'une inscription en attente realigne sur le profil.
  REGISTRATION_SNAPSHOT_REFRESHED
  BADGE_PRINTED
  BADGE_BATCH_PRINTED
  BADGE_ALL_ACCESS_TOGGLED
  BADGE_EXPORTED
  BADGE_BATCH_EXPORTED
  BADGE_SCANNED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_PASSWORD_SET
  USER_LOGIN
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  CATEGORY_TEMPLATE_CREATED
  CATEGORY_TEMPLATE_UPDATED
  CATEGORY_TEMPLATE_DELETED
  ORG_CREATED
  ORG_UPDATED
  ORG_ARCHIVED
  ORG_RESTORED
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_ARCHIVED
  EVENT_RESTORED
  EVENT_REGISTRATION_OPENED
  EVENT_REGISTRATION_CLOSED
  MEMBERSHIP_ADDED
  MEMBERSHIP_REMOVED
  MEMBERSHIP_ROLE_CHANGED
  PLATFORM_SETTINGS_UPDATED
  EVENT_SETTINGS_UPDATED

  // v2-11 : comptes participants
  USER_REGISTERED
  USER_EMAIL_VERIFIED
  USER_PASSWORD_RESET_REQUESTED
  USER_PASSWORD_RESET_COMPLETED
  USER_PROFILE_UPDATED
  USER_BLOCKED
  USER_UNBLOCKED

  // v2-14 Task 6 : hard delete org tracee
  ORG_DELETED

  // v2-14 Task 7 (ADR blocklist scope plateforme) : blocages globaux par staff.
  PLATFORM_BLOCKED_EMAIL_ADDED
  PLATFORM_BLOCKED_EMAIL_REMOVED
  PLATFORM_BLOCKED_DOCUMENT_ADDED
  PLATFORM_BLOCKED_DOCUMENT_REMOVED

  // v4 : abonnements (remplacent les quotas)
  PLAN_CREATED
  PLAN_UPDATED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  QUOTA_BYPASS

  // v4 (plan 08) : validation des profils par le staff plateforme
  PROFILE_SUBMITTED
  PROFILE_APPROVED
  PROFILE_REJECTED
  REJECTION_REASON_CREATED
  REJECTION_REASON_UPDATED
  REJECTION_REASON_ARCHIVED

  // v4 (plan 11) : catalogue des templates de badge installes
  BADGE_TEMPLATE_INSTALLED
  BADGE_TEMPLATE_ARCHIVED

  // v4 spec 23 : queue d'emails
  JOB_RETRIED
  JOB_CANCELLED

  // Paiement d'abonnement (FedaPay)
  PAYMENT_INITIATED
  PAYMENT_APPROVED
  PAYMENT_FAILED
}

// =====================================================
//  Abonnements (v4) - remplacent les champs quota* de Organization
// =====================================================

model Plan {
  id                      String             @id @default(cuid())
  name                    String             @unique
  maxEvents               Int? // null = illimite
  maxParticipantsPerEvent Int? // null = illimite
  // v4 : periodicite de l'offre. Un abonnement souscrit a ce plan en herite ;
  // elle pilote le calcul de startDate/endDate (MONTHLY=30j, ANNUAL=365j).
  period                  SubscriptionPeriod @default(MONTHLY)
  archived                Boolean            @default(false)
  // Prix en XOF (entier) ; null = plan non payable en ligne (ex. free).
  price                   Int?
  createdAt               DateTime           @default(now())
  subscriptions           Subscription[]
  scheduledSubscriptions  Subscription[]     @relation("ScheduledPlan")
  payments                Payment[]
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionPeriod {
  MONTHLY // 30 jours
  ANNUAL // 365 jours
}

model Subscription {
  id                              String                 @id @default(cuid())
  orgId                           String                 @unique // un abonnement courant par org
  org                             Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planId                          String
  plan                            Plan                   @relation(fields: [planId], references: [id])
  status                          SubscriptionStatus     @default(ACTIVE)
  startDate                       DateTime               @default(now())
  endDate                         DateTime? // null = sans echeance
  // Overrides par org (null = herite du plan)
  overrideMaxEvents               Int?
  overrideMaxParticipantsPerEvent Int?
  // Plan programme pour prendre le relais a l'echeance (changement SCHEDULED).
  scheduledPlanId                 String?
  scheduledPlan                   Plan?                  @relation("ScheduledPlan", fields: [scheduledPlanId], references: [id], onDelete: SetNull)
  reminders                       SubscriptionReminder[]
  createdAt                       DateTime               @default(now())
  updatedAt                       DateTime               @updatedAt

  @@index([planId])
  @@index([scheduledPlanId])
}

// Rappel d'echeance deja envoye (idempotence : un rappel par echeance et par delai).
model SubscriptionReminder {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  endDate        DateTime
  daysBefore     Int
  sentAt         DateTime     @default(now())

  @@unique([subscriptionId, endDate, daysBefore])
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELED
  EXPIRED
}

enum SubscriptionChangeMode {
  IMMEDIATE
  EXTENSION
  SCHEDULED
}

// Paiement FedaPay d'un abonnement. Seule la transaction relue via l'API fait foi.
model Payment {
  id                   String                  @id @default(cuid())
  orgId                String
  org                  Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan                    @relation(fields: [planId], references: [id])
  userId               String? // payeur
  user                 User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount               Int
  currency             String                  @default("XOF")
  status               PaymentStatus           @default(PENDING)
  fedapayTransactionId Int?                    @unique
  fedapayReference     String?
  mode                 SubscriptionChangeMode?
  approvedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([orgId, createdAt])
  @@index([status, createdAt])
  @@index([planId])
  @@index([userId])
}

enum JobType {
  EMAIL
}

enum JobStatus {
  PENDING // en attente (y compris en attente d'un nouvel essai)
  RUNNING // pris par un worker
  SUCCEEDED
  FAILED // echec definitif (tentatives epuisees)
  CANCELLED // annule par le staff
}

model Job {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(PENDING)
  priority    Int       @default(0) // plus grand = plus prioritaire
  // EMAIL : { to, subject, html, kind, ctx?, replyTo? }. Purge (html vide) apres succes.
  payload     Json
  // Champs denormalises pour l'ecran d'admin (filtres, recherche) sans lire le payload.
  kind        String // ex. "registration.approved"
  recipient   String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now()) // prochain essai
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?   @db.Text
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt, priority])
  @@index([type, createdAt])
}

// =====================================================
//  Notifications internes (v4, spec 24)
// =====================================================

enum NotificationType {
  REGISTRATION_CREATED
  REGISTRATION_RESUBMITTED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  BADGE_PRINTED
  PROFILE_SUBMITTED
  PROFILE_APPROVED
  PROFILE_REJECTED
  ORG_MEMBERSHIP_ADDED
  EVENT_MEMBERSHIP_ADDED
  MEMBERSHIP_ROLE_CHANGED
  EVENT_REGISTRATION_OPENED
  EVENT_REGISTRATION_CLOSED
  ORG_CREATED
  SUBSCRIPTION_CHANGED
  QUOTA_EXCEEDED
  EMAIL_FAILED
  SUBSCRIPTION_EXPIRING
}

enum NotificationScope {
  PLATFORM // destinee au staff plateforme
  ORG
  EVENT
  PARTICIPANT
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  scope     NotificationScope
  orgId     String?
  eventId   String?
  title     String
  body      String            @db.Text
  // Lien principal, relatif a l'app (ex. "/event/abc/registrations/xyz").
  href      String?
  // Liens : [{ label, href }], le lien principal en tete puis les liens secondaires.
  links     Json?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, scope, createdAt])
}

// --- Gabarits d'impression et planches de badges -----------------------------

enum SheetOrientation {
  PORTRAIT
  LANDSCAPE
}

enum BadgeOrientation {
  AUTO
  ORIGINAL
  ROTATED
}

enum DuplexFlip {
  LONG_EDGE
  SHORT_EDGE
}

enum PrintSheetGenerationStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum GenerationOutput {
  SHEETS
  ZIP
}

// Toutes les longueurs sont en dixiemes de mm. Format stocke en portrait
// (sheetWidth <= sheetHeight) ; l'orientation est portee par sheetOrientation.
model PrintSheetLayout {
  id               String           @id @default(cuid())
  name             String           @unique
  sheetWidth       Int
  sheetHeight      Int
  sheetOrientation SheetOrientation
  marginTop        Int
  marginRight      Int
  marginBottom     Int
  marginLeft       Int
  gapHorizontal    Int
  gapVertical      Int
  badgeOrientation BadgeOrientation @default(AUTO)
  duplexFlip       DuplexFlip       @default(LONG_EDGE)
  cropMarks        Boolean          @default(true)
  archived         Boolean          @default(false)
  archivedAt       DateTime?
  createdById      String?
  createdBy        User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  generations PrintSheetGeneration[]
}

model PrintSheetGeneration {
  id              String                     @id @default(cuid())
  output          GenerationOutput           @default(SHEETS)
  eventId         String
  event           Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  layoutId        String?
  layout          PrintSheetLayout?          @relation(fields: [layoutId], references: [id], onDelete: SetNull)
  // { spec, badgeMm, badgePages } fige a la creation ; null pour ZIP.
  layoutSnapshot  Json?
  duplex          Boolean                    @default(false)
  registrationIds Json
  status          PrintSheetGenerationStatus @default(PENDING)
  attempts        Int                        @default(0)
  lockedBy        String?
  heartbeatAt     DateTime?
  sheetCount      Int?
  badgeCount      Int?
  skippedIds      Json?
  fileKey         String?
  error           String?                    @db.Text
  createdById     String?
  createdBy       User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime                   @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  @@index([status, createdAt])
  @@index([eventId])
}

enum PrintProductKind {
  BADGE
  ACCESSORY
}

enum PrintOptionType {
  CHOICE
  MULTI_CHOICE
  COLOR
  TEXT
  FILE
  QUANTITY_SPLIT
}

// Catalogue des produits d'impression. Prix en plus petite unite de la devise.
model PrintProduct {
  id           String           @id @default(cuid())
  kind         PrintProductKind
  name         String           @db.VarChar(120)
  slug         String           @unique
  category     String?          @db.VarChar(60)
  description  String?          @db.Text
  basePrice    Int
  minQuantity  Int              @default(1)
  leadTimeDays Int?
  position     Int              @default(0)
  published    Boolean          @default(false)
  archived     Boolean          @default(false)
  archivedAt   DateTime?
  createdById  String?
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  images     PrintProductImage[]
  priceTiers PrintProductPriceTier[]
  options    PrintProductOption[]

  @@index([kind, archived, published])
}

model PrintProductImage {
  id         String       @id @default(cuid())
  productId  String
  product    PrintProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey String
  alt        String       @default("") @db.VarChar(200)
  position   Int

  @@index([productId, position])
}

model PrintProductPriceTier {
  id          String       @id @default(cuid())
  productId   String
  product     PrintProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity Int
  unitPrice   Int

  @@unique([productId, minQuantity])
}

model PrintProductOption {
  id         String          @id @default(cuid())
  productId  String
  product    PrintProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String          @db.VarChar(80)
  help       String?         @db.VarChar(300)
  type       PrintOptionType
  required   Boolean         @default(false)
  // TEXT et FILE : supplement de prix.
  priceDelta Int             @default(0)
  // TEXT : longueur maximale.
  maxLength  Int?
  position   Int
  archived   Boolean         @default(false)
  archivedAt DateTime?

  values PrintProductOptionValue[]

  @@index([productId, position])
}

model PrintProductOptionValue {
  id         String             @id @default(cuid())
  optionId   String
  option     PrintProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  label      String             @db.VarChar(80)
  colorHex   String?            @db.VarChar(7)
  imageKey   String?
  priceDelta Int                @default(0)
  position   Int
  archived   Boolean            @default(false)
  archivedAt DateTime?

  @@index([optionId, position])
}
