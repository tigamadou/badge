# ============================================================
#  Badge v2 — .env.production.example
#  Copier ce fichier en .env.production et remplir les valeurs.
#  Ne jamais committer .env.production (cf .gitignore).
# ============================================================

# --- Base de donnees ---
DATABASE_URL=mysql://root:CHANGE_ME@mysql:3306/badge
MYSQL_ROOT_PASSWORD=CHANGE_ME

# --- NextAuth ---
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
NEXTAUTH_URL=https://badge.exemple.tld
BASE_URL=https://badge.exemple.tld

# --- SMTP plateforme (source unique, v2) ---
# Decision 2026-05-31 : aucun override Org/Event. Tous les emails partent avec
# cette identite d'expediteur, le branding contextuel (logo, contact) est
# cascade depuis l'event/organisation.
PLATFORM_SMTP_HOST=smtp.exemple.tld
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_FROM=noreply@badge.exemple.tld
PLATFORM_SMTP_USER=noreply@badge.exemple.tld
PLATFORM_SMTP_PASSWORD=CHANGE_ME
PLATFORM_SMTP_SECURE=false

# --- Seed SUPER_ADMIN initial (a changer apres le premier login via /profile) ---
# Cree par le service compose `init` uniquement si la base ne contient aucun
# SUPER_ADMIN ; ensuite ces variables ne sont plus lues.
SEED_SUPER_ADMIN_EMAIL=admin@badge.exemple.tld
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_temporary
# Optionnel (defaut : "Super Admin")
SEED_SUPER_ADMIN_NAME=

# --- reCAPTCHA (source unique plateforme, v2) ---
# Decision 2026-05-31 : aucun override Org/Event. Une seule cle Google
# partagee pour tous les events. Laisser vide pour desactiver le widget.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Secret HMAC pour signer les upload tokens publics (Plan v2-05).
# Generer avec : openssl rand -base64 32
UPLOAD_TOKEN_SECRET=

# --- Stockage objet S3-compatible (service `rustfs` de la stack) ---
# S3_ENDPOINT utilise le container_name (pas l alias `rustfs`, ambigu sur le
# reseau `badge_web` partage avec la preprod), jamais un port hote.
# RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY sont lus par le conteneur rustfs ;
# S3_ACCESS_KEY / S3_SECRET_KEY par l'app : mettre les memes valeurs.
S3_ENDPOINT=http://badge-rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=badge
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME

# --- Service de rendu (service `renderer` de la stack) ---
# RENDERER_URL est pose par le compose (environment: de app, init et tools) :
# http://badge-renderer:3000 en production, http://badge-renderer-preprod:3000 en
# preproduction. Ne rien definir ici. Le service tourne sur un reseau interne, sans
# acces sortant, et n'est jamais publie.
