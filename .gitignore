# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production.example

# Claude Code (preferences personnelles, non partagees)
.claude/settings.local.json

# uploads
/uploads

# Badge v2 - backups locaux (mysqldump + uploads.tar.gz)
backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright (v2-11)
/test-results/
/playwright-report/
/playwright/.cache/

.plan-logs
.superpowers

# racine CA Caddy extraite temporairement par `make dev-https`
.caddy-root.crt

# Worktrees de developpement parallele (voir chore(dev))
/.worktrees/

# Stack d agent (scripts/agent-stack.sh) : propre a chaque worktree
.agent.env

# Fichier des comptes du seed de demo (genere)
.demo/
